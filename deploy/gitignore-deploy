# .gitignore used on the deploy branch only.
#
# The deploy branch is a build output: unlike main it *does* track vendor/ and
# public/build, because Hostinger shared hosting has no reliable Composer or
# Node toolchain to produce them on the server.
#
# CI copies this file over the repository's root .gitignore when it assembles
# a release. Do not point hPanel at a branch that uses the normal .gitignore --
# the site will 500 on a missing vendor/autoload.php.
#
# Note the "!.gitignore" negations below. Git cannot track an empty directory,
# so Laravel's writable directories only survive a git pull because of the
# placeholder .gitignore file inside each one. Excluding those placeholders
# would leave the server without storage/framework/views and every request
# would fail on an unwritable compiled-view path.

.env
.env.backup
.env.production
/node_modules
/public/hot
/public/storage
/storage/*.key

/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore

/bootstrap/cache/*
!/bootstrap/cache/.gitignore

*.log
.DS_Store
Thumbs.db
