# ---------------------------------------------------------------------------
# Production environment template for Hostinger shared hosting.
#
# Copy this to .env on the server (hPanel > File Manager, inside public_html)
# and fill in the blanks. It is never committed with real values -- .env is
# gitignored, and the deploy branch does not carry one.
#
# After editing .env you must re-run deploy/post-deploy.sh (or at minimum
# `php artisan config:cache`) or the old cached config stays live.
# ---------------------------------------------------------------------------

APP_NAME="Barangay San Jose"
APP_ENV=production
# Generate once with `php artisan key:generate --show` and paste the result.
# Changing this invalidates every existing session and encrypted value.
APP_KEY=
APP_DEBUG=false
# Must match the live domain exactly, including https://, or generated links
# and password reset e-mails will point at the wrong host.
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# MySQL credentials from hPanel > Databases > Management. Hostinger prefixes
# both the database and user name with your account id (e.g. u123456789_).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave null unless the app is shared across subdomains.
SESSION_DOMAIN=null
# Shared hosting terminates TLS in front of PHP; keep cookies HTTPS-only.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Resend handles outbound mail (receipts, password resets). Key from
# resend.com > API Keys. MAIL_FROM_ADDRESS must be on a verified domain.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# PayMongo live keys. Use the live (pk_live_/sk_live_) pair here -- test keys
# will silently accept payments that never settle.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_TRANSACTION_FEE=20

# Contact details in the footer of every outgoing email. Fill in the phone
# number and Facebook page URL to have those show up; blank entries are left
# out of the footer rather than rendered empty.
BARANGAY_ADDRESS="Purok 5, San Jose, Talibon, Bohol"
BARANGAY_EMAIL=blgusanjosetalibon1910@gmail.com
BARANGAY_PHONE=
BARANGAY_FACEBOOK_NAME="Barangay San Jose"
BARANGAY_FACEBOOK_URL=
